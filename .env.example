# ==============================================================================
# Variables de entorno para Producción (Demo Portfolio)
# ==============================================================================

# --- Servidor (apps/server) ---
NODE_ENV=production
PORT=1234
HOST=0.0.0.0

# Activar detrás de proxy inverso (Render, Fly.io, Railway, Nginx, Caddy) para rate limiting por IP real
TRUST_PROXY=true

# Ruta persistente para SQLite (en contenedores montar volumen en /data)
DATABASE_PATH=/data/kanban-data.sqlite

# Opcional: si sirves frontend y backend desde el mismo servidor (todo-en-uno),
# puedes dejar CORS_ORIGIN vacío (aceptará same-host) o fijar tu URL exacta:
# CORS_ORIGIN=https://tu-kanban-demo.onrender.com
CORS_ORIGIN=

# Ruta a los archivos estáticos compilados de Vite (opcional; se autodetecta en producción)
# STATIC_DIR=/app/apps/client/dist

# Ajustes opcionales de WebSocket / Salas
MAX_WS_PAYLOAD_BYTES=65536
ROOM_IDLE_TTL_MS=300000
WS_HEARTBEAT_INTERVAL_MS=15000

# --- Cliente (solo si despliegas frontend separado en Vercel / Cloudflare Pages) ---
# VITE_API_URL=https://tu-backend.onrender.com
# VITE_WS_URL=wss://tu-backend.onrender.com/rooms/
